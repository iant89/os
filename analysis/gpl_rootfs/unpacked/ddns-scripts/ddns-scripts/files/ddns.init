#!/bin/sh /etc/rc.common
START=99
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /bin/sh "/usr/lib/ddns/dynamic_dns_updater.sh" "start"
	procd_set_param limits core="unlimited"
	procd_close_instance
}

service_triggers()
{
	procd_add_reload_trigger "ddns"
}

reload_service()
{
	stop
	start
}